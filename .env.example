# Copiar a .env y ajustar. Ningún valor real de este fichero debe
# subirse al repositorio.

# ============================================================ aplicación
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=false
API_PORT=8000

# ================================================================== WAHA
# Dentro de docker compose el host es el nombre del servicio.
WAHA_BASE_URL=http://waha:3000
WAHA_SESSION=default
# Clave de la API de WAHA (debe coincidir con WHATSAPP_API_KEY del contenedor).
WAHA_API_KEY=
# Escribe los envíos en el log en vez de mandarlos. Útil para probar sin
# quemar una sesión de WhatsApp real.
WAHA_DRY_RUN=false
WAHA_TIMEOUT_SECONDS=15
# Reintentos de las consultas a WAHA.
WAHA_MAX_RETRIES=3
# Reintentos de los envíos: menos a propósito. Los envíos se serializan por el
# rate limit de WhatsApp, así que insistir en uno retrasa a todos los demás.
WAHA_SEND_MAX_RETRIES=2
# Intervalo mínimo entre envíos: WhatsApp penaliza las ráfagas.
WAHA_MIN_SEND_INTERVAL=0.4

# Estas tres las lee docker-compose, no la aplicación, y sólo importan si
# levantas la WAHA del stack con "docker compose --profile waha up -d".
WAHA_PORT=3000
# Imagen de WAHA. El tag por defecto sólo publica amd64; en Apple Silicon
# usa devlikeapro/waha:arm, que es nativo.
WAHA_IMAGE=devlikeapro/waha:latest
# NOWEB es el motor más liviano; WEBJS usa un Chromium completo.
WAHA_ENGINE=NOWEB

# ============================================================== seguridad
# Firma HMAC de los webhooks (WHATSAPP_HOOK_HMAC_KEY en WAHA). Muy
# recomendable si el servicio está expuesto.
WAHA_WEBHOOK_HMAC_SECRET=
# Alternativa simple: cabecera X-Webhook-Secret.
WEBHOOK_SHARED_SECRET=

# ================================================================ control
# Números autorizados a lanzar y cancelar partidas. Con o sin "+", con o sin
# "@c.us": se normaliza solo. Admite varios separados por comas. Los avisos
# de una partida van a quien la haya lanzado.
MANAGER_NUMBER=+573001234567
COMMAND_PREFIX=#
# Silenciar el grupo de noche ("sólo administradores"). Requiere WAHA Plus y
# que el número del bot sea administrador del grupo. Con false la partida
# funciona igual, pero el silencio es una convención, no una restricción.
MANAGE_GROUP_PERMISSIONS=true
# Etiquetar contactos en los mensajes del grupo (@número + mentions de WAHA).
# Deja inequívoco de quién se habla y a quién ignorar. Con false, nombres planos.
USE_MENTIONS=true

# =================================================================== LLM
# Cada juego declara si necesita modelo. El Hombre Lobo y Kahoot lo reciben
# sin que el máster escriba nada; un juego que no lo declare narra con el
# modelo sólo si se lanza con `#juego <nombre> ia`, para no gastar API sin
# que nadie lo pida. Sin clave el cliente nace apagado y se juega con los
# textos estáticos.
# gemini | deepseek | openai | none ("none" desactiva el modelo del todo).
# El nombre sólo dice a quién se llama; todos entran por el dialecto de
# OpenAI, así que lo que importa de verdad es BASE_URL y MODEL.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_TEMPERATURE=0.9
LLM_MAX_TOKENS=700
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# ================================================================= Redis
REDIS_URL=redis://redis:6379/0
# Tope de conexiones simultáneas a Redis (el pool espera, no falla).
REDIS_MAX_CONNECTIONS=32
REDIS_POOL_TIMEOUT=10
# TTL de los buzones de mensajes de cada partida.
INBOX_TTL_SECONDS=900
PURGE_INBOX_ON_FINISH=true

# ============================================================ persistencia
DATABASE_URL=sqlite+aiosqlite:////app/data/games.db
# SQLite sólo admite un escritor: un pool pequeño rinde más y gasta menos hilos.
DB_POOL_SIZE=2
DB_BUSY_TIMEOUT=30
# sqlite | memory
CHECKPOINTER=sqlite
CHECKPOINTER_PATH=/app/data/checkpoints.db
MESSAGE_RETENTION_DAYS=30

# ================================================================ tiempos
# Todos en segundos.
RECRUIT_SECONDS=30
NIGHT_ACTION_SECONDS=60
WITCH_ACTION_SECONDS=45
HUNTER_ACTION_SECONDS=40
DEBATE_SECONDS=90
VOTE_SECONDS=30
# Cada cuánto manda ambientación mientras espera (0 lo desactiva).
FILLER_INTERVAL_SECONDS=25
MAX_ROUNDS=20
# Tope de nodos que puede recorrer el grafo. Se eleva solo si MAX_ROUNDS lo
# necesita, así que rara vez hay que tocarlo.
GRAPH_RECURSION_LIMIT=250

# ================================================================ Kahoot
# Valores por defecto; el comando puede cambiarlos sobre la marcha
# (`!juego kahoot 15 preguntas de 10 segundos sobre cine`).
KAHOOT_QUESTIONS=10
KAHOOT_SECONDS_PER_QUESTION=10
# Las encuestas de WhatsApp admiten hasta 12 opciones.
KAHOOT_OPTIONS=5
KAHOOT_MAX_QUESTIONS=30
KAHOOT_MAX_SECONDS=120
# Silenciar el grupo mientras se juega. Si nadie vota la primera pregunta se
# reabre solo, por si el silencio estuviera impidiendo votar.
KAHOOT_LOCK_GROUP=true
# Modelo para escribir las preguntas. Vacío usa LLM_MODEL. El
# cuestionario se genera antes de empezar, así que aquí se puede pagar
# más latencia por mejores preguntas que en la narración en vivo.
# Segunda pasada de revisión para endurecer las preguntas. Cuesta otra
# llamada al modelo; con false se genera de una sola pasada.
KAHOOT_HARDEN=true
# El concurso puede apuntar a otro proveedor entero. Lo que se le pide
# —un cuestionario exigente y correcto— lo hacen bien los modelos que
# razonan, y esos son demasiado lentos para narrar en mitad de una
# partida. Los tres vacíos usan la configuración general.
KAHOOT_LLM_MODEL=
KAHOOT_LLM_BASE_URL=
KAHOOT_LLM_API_KEY=
# Cuánto se le deja pensar antes de escribir (none/low/medium/high), en
# los modelos que razonan. Vacío no manda el parámetro.
KAHOOT_LLM_REASONING_EFFORT=

# ========================================================= El Hombre Lobo
WEREWOLF_MIN_PLAYERS=4
WEREWOLF_MAX_PLAYERS=24
# none = un empate no lincha a nadie; random = decide el azar.
WEREWOLF_TIE_BREAK=none
# Revelar el rol de quien muere de noche (el del linchado siempre se revela).
WEREWOLF_REVEAL_ROLE_ON_DEATH=true
